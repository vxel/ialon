Material water-calm : Blocks/MatDefs/Water.j3md {

    MaterialParameters {

        // The water tint and packed light level are carried by the vertex colours (see
        // FacesMeshGenerator.emitCalmQuad), so vertex colour is always on.
        UseVertexColor : true

        // Only the alpha is used (base transparency looking straight down). The game overrides it
        // from IalonConfig.calmWaterColor at load time ; this is the default.
        Diffuse : 1.0 1.0 1.0 0.92

        // --- Wave (normal perturbation) tuning ---
        WaveScale : 0.1
        WaveSpeed : 0.4
        WaveAmplitude : 0.18
        WaveFadeNear : 30.0
        WaveFadeFar : 200.0

        // --- Sun glint / Fresnel tuning ---
        GlintPower : 220.0
        GlintStrength : 2.2
        FresnelPower : 5.0

        // Underside brightness (underwater looking up) : transmitted sky + refracted sun/moon sparkle.
        UnderStrength : 1.0
        // Underside sun sparkle : broad glow (low power) and strong scatter -> wide, shattered "éclaté" sun.
        UnderGlintPower : 30.0
        UnderScatter : 6.0

        // Sky reflection (0 = none, 1 = mirror).
        ReflectionStrength : 1.0

        // --- Dynamic uniforms : first-frame placeholders, overwritten every update by WaterState
        // with the live sun direction and sky colours. ---
        SunDirection : 0.4 0.85 0.34
        SunColor : 1.0 1.0 1.0 1.0
        // Moon : direction pushed by WaterState ; colour (cool pale white) and a fainter glint are static.
        MoonDirection : 0.0 -1.0 0.0
        MoonColor : 0.55 0.62 0.78 1.0
        MoonGlintStrength : 0.6
        SkyColor : 0.25 0.55 1.0 1.0
        SkyHorizonColor : 0.7 0.82 1.0 1.0

        // Emulate the sRGB pipeline in-shader on platforms without an sRGB framebuffer (Android GLES).
        // Overridden from IalonConfig.manualGammaEncode at load time.
        ManualSrgb : false
    }

    AdditionalRenderState {
        Blend Alpha
        // Double-sided, in ONE draw call. The calm surface is a flat, single-layer greedy mesh, so a
        // given pixel is covered by a face that is either front-facing (camera above) or back-facing
        // (camera below), never both : one double-sided geometry draws exactly the same fragments as
        // the outside/inside geometry pair it replaces, and Water.frag already picks the top-side or
        // underside shading from vWorldPos.y vs g_CameraPosition.y rather than from the cull mode.
        // (The volumetric `water` type still needs the two-geometry trick : there, near and far faces
        // of the same body DO overlap and must be blended back-to-front.)
        FaceCull Off
        // Transparent surface : do not write depth, otherwise the water lays down depth in front of
        // other transparents drawn after it (the emissive fire billboard, layer 3) and depth-culls
        // them — a fire in a dry pocket seen through submerged water would vanish. Correctness against
        // the opaque terrain still comes from the depth *test* + PolyOffset below.
        DepthWrite Off
        // Nudge towards the camera so the flat surface wins over the textured side faces at the seam.
        PolyOffset -0.1 -0.1
    }
}
